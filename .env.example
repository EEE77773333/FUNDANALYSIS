# ============================================================
# 基金智能分析系统 — 环境变量配置
# ============================================================
# 使用方式：cp .env.example .env  然后按需填写
#
# ⚠️ 全部留空也能跑起来：
#    - 本地单机（SQLite）：直接 `streamlit run app.py`，无需本文件
#    - Docker：`docker compose up -d`，数据库与会话密钥自动生成
#    - AI 模型：留空也没关系，登录后在「账户设置 → 🔌 AI 与数据源」里填写即可
#
# 一句话：这个文件只给「想一次性配好、不想在界面里点」的自部署用户用。
# ============================================================


# ============================================================
# 一、AI 模型（BYOK：自带密钥）
# ============================================================
# 系统统一走 OpenAI 兼容协议，所以下面三个变量就能接上绝大多数模型服务：
# 云端 API（DeepSeek / 通义千问 / 智谱 GLM / Kimi / OpenAI / 硅基流动 / OpenRouter）
# 本地推理（Ollama / vLLM / LM Studio）
#
# 全部留空 → AI 功能置灰并给出配置引导，
#           但筛选、回测、费率计算等纯本地功能**完全可用**。

# 服务商预设。可选值：
#   deepseek | qwen | glm | kimi | openai | siliconflow | openrouter
#   anthropic | ollama | vllm | lmstudio | custom
# 填了预设后，base_url 与常用模型会自动带出，通常只需再填 LLM_API_KEY。
LLM_PRESET=

# 接口地址（OpenAI 兼容端点）。留空则用预设自带地址。
# 例：https://api.deepseek.com/v1
# Docker 部署时若想连宿主机的 Ollama，请写 http://host.docker.internal:11434/v1
LLM_BASE_URL=

# API Key。本地推理服务（Ollama/vLLM）通常不需要，可留空。
# DeepSeek 获取地址：https://platform.deepseek.com/api_keys
LLM_API_KEY=

# 模型名称。留空则用预设的推荐模型。
# 例：deepseek-chat / qwen-plus / glm-4-flash / qwen2.5:7b
LLM_MODEL=


# ---- 旧版变量（继续兼容，无需改动已有配置）----
# 如果之前用的是 DEEPSEEK_* 写法，可以原样保留，
# 系统会自动识别为 deepseek 预设，无需迁移。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6


# ============================================================
# 二、行情数据源
# ============================================================
# 可选：akshare | tushare | eastmoney | baostock
# 说明：
#   eastmoney  东财/天天基金直连，零额外依赖，默认主力通道
#   akshare    免费免 token，覆盖面广（需 pip install akshare）
#   tushare    数据质量更好，需下方 token（免费注册）
#   baostock   免费免 token，日线为主
# 系统会按「东财 → AKShare → Tushare → Baostock」自动降级，主源失败自动切备用源。
DATA_PROVIDER=akshare

# Tushare token。获取地址：https://tushare.pro （注册后在个人中心查看）
TUSHARE_TOKEN=

# 行情缓存有效期（秒）。缓存能显著减少对公共数据源的请求，避免被限流。
# 建议：日线数据 1800~3600，实时估值 180~300。
QUOTE_CACHE_TTL=300

# 设为 1 可完全关闭行情缓存（调试用）
# DISABLE_QUOTE_CACHE=0


# ============================================================
# 三、部署形态
# ============================================================
# community（默认）= 开源自部署：不限制使用次数，AI 成本由你自己的 key 承担
#
# cloud           = 托管运营版：按用户套餐执行配额与计费
#                   （你自己运营云服务、对外收订阅费时才需要设成这个）
EDITION=community

# 对外端口（Docker）
# APP_PORT=8501

# 时区
# TZ=Asia/Shanghai


# ============================================================
# 四、数据库与会话安全
# ============================================================
# 不设置 DATABASE_URL → SQLite 单机模式（data/fund_analysis.db），免登录直接用。
# 设置 → PostgreSQL 多用户模式，支持多账号与套餐配额。
#
# ⚠️ 注意：一旦设置 DATABASE_URL，连接失败会直接阻止启动，
#    不会静默降级到 SQLite（避免双库脑裂导致数据错乱）。
#
# 本地 Docker 环境通常无需填写 —— docker-compose 会自动连内置 postgres。
# 云上自建请写成：postgresql://用户:密码@主机:5432/库名
# DATABASE_URL=postgresql://fundadmin:changeme@postgres:5432/fund_analysis

# Postgres 密码（Docker 内置库使用）
# DB_PASSWORD=请改成强密码

# 默认管理员密码。仅多用户模式首次初始化时创建。
# 不设置则不创建管理员，避免留下弱口令后门。
# ADMIN_DEFAULT_PASSWORD=请设置强密码

# 会话签名密钥。不设置则自动生成并持久化到 data/.jwt_secret。
# 生产环境建议显式设置一个长随机串（可用 `openssl rand -hex 32` 生成）。
# JWT_SECRET=

# 登录态有效期（小时）
# JWT_EXPIRY_HOURS=24


# ============================================================
# 五、可选：REST API 服务
# ============================================================
# 启用 api/ 目录下的 FastAPI 服务时使用。
# /api/v1/* 全部端点需请求头 X-API-Key 匹配此值；不设置则 API 拒绝所有请求。
# API_ACCESS_KEY=
# CORS 允许来源（逗号分隔），默认不允许跨域。
# CORS_ALLOW_ORIGINS=


# ============================================================
# 六、其他
# ============================================================
# 数据目录（默认项目下的 data/；容器内固定为 /app/data）
# DATA_DIR=

# SSL 证书校验。默认开启（生产必须）。
# 仅在本地证书链不全时临时设为 1 绕过。
# DISABLE_SSL_VERIFY=0
