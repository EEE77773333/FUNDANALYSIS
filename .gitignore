# ============================================================
# 基金智能分析系统 — Git 忽略规则
# 原则：任何私密配置、用户数据、运行时缓存都不得进入版本库
# ============================================================

# ---- 私密配置（绝不提交）----
.env
.env.local
.env.*.local
*.secret
.jwt_secret
data/.jwt_secret

# ---- 用户数据与数据库 ----
*.db
*.sqlite
*.sqlite3
data/fund_analysis.db
data/notification_config.json

# ---- 运行时缓存与快照（本地生成，无长期价值）----
data/*_cache.json
data/evaluation_last_run.txt
data/intraday_snapshots/
data/theme_flow_snapshots/
data/strategies/*
!data/strategies/.gitkeep
logs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
.venv_*/
env/
ENV/

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- 编辑器与工具链 ----
.claude/
.trae/
.agents/
.idea/
.vscode/
*.swp
*~

# ---- 操作系统 ----
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- 导出产物 ----
exports/
*.xlsx
*.docx
*.pdf
!docs/**/*.pdf

# ---- 非产品代码（一次性脚本，不属于开源交付物）----
make_kimi_k3_ppt.py
